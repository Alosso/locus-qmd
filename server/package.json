{
  "name": "locus-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "serve": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "index": "tsx scripts/build-index.ts",
    "graph": "tsx scripts/build-graph.ts",
    "eval": "tsx scripts/eval.ts",
    "bench": "tsx scripts/bench.ts",
    "ask": "tsx scripts/ask.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@livekit/agents": "^1.9.5",
    "@livekit/agents-plugin-anthropic": "^1.9.5",
    "@livekit/agents-plugin-cartesia": "^1.9.5",
    "@livekit/agents-plugin-deepgram": "^1.9.5",
    "@livekit/agents-plugin-livekit": "^1.9.5",
    "@livekit/agents-plugin-openai": "^1.9.5",
    "@livekit/agents-plugin-silero": "^1.9.5",
    "@tobilu/qmd": "^2.8.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "livekit-server-sdk": "^2.19.2",
    "openai": "^7.54.0",
    "ws": "^8.22.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
