# Copy to .env and fill in. Never commit .env.

# --- API -------------------------------------------------------------------
PORT=8080
# Required on any public deployment: clients send "Authorization: Bearer <token>".
API_AUTH_TOKEN=

# --- LLM (answers) -----------------------------------------------------------
# anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional overrides. Defaults: anthropic claude-sonnet-5-5 (text) / claude-haiku-5-5 (voice),
# openai gpt-4.1 / gpt-4.1-mini.
# LLM_TEXT_MODEL=
# LLM_VOICE_MODEL=
# LLM_TEXT_EFFORT=medium
# LLM_VOICE_EFFORT=low

# --- Voice (LiveKit Cloud project) -----------------------------------------
# Leave empty to run text-only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Speech models served through LiveKit Inference (no extra provider keys needed).
# STT_MODEL=deepgram/nova-3
# TTS_MODEL=cartesia/sonic-3
# TTS_VOICE=

# --- Retrieval ---------------------------------------------------------------
# RETRIEVAL_TOP_K=6
# RETRIEVAL_VOICE_TOP_K=4
# Cross-encoder reranking; adds seconds per query on CPU.
# RETRIEVAL_RERANK=false

# --- Paths (defaults are right for local use) --------------------------------
# DATA_DIR=data
# CORPUS_DIR=corpus
# GAME=wh40k

# --- Ingestion ---------------------------------------------------------------
# Model for `python -m locus_ingest run --llm` (uses ANTHROPIC_API_KEY).
# LOCUS_INGEST_MODEL=claude-opus-5-5
